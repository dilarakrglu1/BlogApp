@model UpdateBlogModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4 rounded-top-4">
                    <h3 class="mb-0 fw-bold">Yeni Blog Yazısı Oluştur</h3>
                    <p class="mb-0 text-white-50 small">Düşüncelerinizi okuyucularınızla paylaşın.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-controller="Blog" asp-action="Update" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                        <input asp-for="Id" hidden="hidden" />

                        <!-- Başlık -->
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-semibold text-dark">Başlık</label>
                            <input asp-for="Title"
                                   type="text"
                                   class="form-control form-control-lg fs-6"
                                   placeholder="Etkileyici bir başlık girin..." value="@Model.Title" />
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- İçerik -->
                        <div class="mb-4">
                            <label asp-for="Content" class="form-label fw-semibold text-dark">İçerik</label>
                            <textarea asp-for="Content"
                                      rows="8"
                                      class="form-control"
                                      placeholder="Blog içeriğinizi buraya detaylıca yazın...">@Model.Content</textarea>
                            <span asp-validation-for="Content" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex gap-3 pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3">İptal</a>
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-3 fw-semibold flex-grow-1">
                                Yayınla
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>